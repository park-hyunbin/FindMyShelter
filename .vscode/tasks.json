{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "데이터: QGIS 편집본 → 웹 GeoJSON",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/backend/scripts/prepare_sample.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "화면: 로컬 미리보기",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/backend/scripts/preview_map.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "화면: 로컬 빌드",
      "problemMatcher": []
    },
    {
      "label": "지형: DEM 샘플 추출·측정",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/backend/scripts/prepare_terrain.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "소하천: 로컬 검증본 만들기",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/backend/scripts/prepare_water.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "화면: 로컬 빌드",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "dependsOn": "데이터: QGIS 편집본 → 웹 GeoJSON",
      "problemMatcher": []
    },
    {
      "label": "도로: 로컬 검증본 만들기",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/backend/scripts/prepare_roads.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
